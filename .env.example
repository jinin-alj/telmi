# Copy to .env and fill in. Never commit .env.

# Postgres used by docker compose and the backend.
# Local names keep the project's original name; nothing outside your machine sees them.
POSTGRES_USER=study_buddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=study_buddy
DATABASE_URL=postgresql+psycopg://study_buddy:change-me@localhost:5432/study_buddy
# Free hosted databases allow few connections
DATABASE_POOL_SIZE=5

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Ollama runs on the host so it can use the Mac GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Reads scratchpad drawings locally; must accept images
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Only for the deployed setup: the laptop's AI gateway key. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(40))"
# Render's OLLAMA_API_KEY must hold the same value.
GATEWAY_API_KEY=

# Origins allowed to call the API (Expo web dev server)
CORS_ORIGINS=http://localhost:8081

# AI provider. Local development uses Ollama (above). The deployed app uses
# an always-on OpenAI-compatible API (Groq): set AI_PROVIDER=hosted and AI_API_KEY.
AI_PROVIDER=ollama
AI_API_KEY=
AI_BUDDY_MODEL=openai/gpt-oss-20b
AI_CHECKER_MODEL=openai/gpt-oss-120b
# Reads scratchpad drawings; must accept images (see "Scratchpad" in the README)
AI_VISION_MODEL=qwen/qwen3.8-27b

# Session caps
SESSION_MINUTES=15
MAX_STUDENT_TURNS=8
